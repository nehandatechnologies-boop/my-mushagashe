# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database
DB_PATH=./database/mushagashe.db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@mushagashe.edu
ADMIN_PASSWORD=admin123

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS - Allow all origins for ngrok
FRONTEND_URL=*

# Password Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
PASSWORD_EXPIRY_DAYS=90

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Session Security
SESSION_TIMEOUT_MINUTES=60

# MFA Configuration
MFA_ENABLED=false
MFA_SECRET_KEY=your-mfa-secret-key-change-in-production

# Data Retention
DATA_RETENTION_DEFAULT_DAYS=3650
AUDIT_LOG_RETENTION_DAYS=1825

# Compliance
DPO_EMAIL=dpo@mushagashe.edu
SECURITY_ALERT_EMAIL=security@mushagashe.edu

