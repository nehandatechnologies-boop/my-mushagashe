# Mushagashe Vocational Training Centre - Environment Variables

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # REQUIRED for admin operations (user creation, migration)

# JWT Configuration (Legacy - will be removed after Supabase Auth migration)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (Legacy - will be removed after Supabase Auth migration)
# Supabase Auth handles email verification automatically - no SMTP credentials needed
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@example.com
# EMAIL_PASS=your-email-app-password
# EMAIL_FROM=Mushagashe VTC <your-email@example.com>

# Frontend URL (for email verification and password reset links)
# For local development:
FRONTEND_URL=http://localhost:5500
# For production (Render deployment), this will be automatically set to:
# https://my-mushagashe.onrender.com

# Server Configuration
PORT=5000
NODE_ENV=development
# Set NODE_ENV=production for Render deployment

# IMPORTANT: To use Supabase Auth, you must:
# 1. Enable email confirmation in Supabase dashboard
# 2. Set redirect URLs in Supabase dashboard to your production URL
# 3. Add SUPABASE_SERVICE_ROLE_KEY from Supabase dashboard (Project Settings > API)


