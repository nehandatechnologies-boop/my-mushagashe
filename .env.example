# Mushagashe Vocational Training Centre - Environment Variables

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for email verification and password reset)
# Required for production email functionality
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=Mushagashe VTC <your-email@example.com>

# Frontend URL (for email verification and password reset links)
FRONTEND_URL=http://localhost:5500
# For production, use your deployed URL:
# FRONTEND_URL=https://your-deployed-domain.com

# Server Configuration
PORT=5000
NODE_ENV=development
